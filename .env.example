# FarmSetu — Environment Configuration
# Project: FarmSetu (AI-Powered Direct Digital Marketplace for Farmers, FPOs & Buyers)

# App Configuration
APP_NAME=FarmSetu
APP_ENV=development
DEBUG=true
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database Configuration (MySQL / SQLAlchemy)
# Example MySQL: mysql+pymysql://root:password@localhost:3306/farmsetu_db
